# === REQUIRED ===

# Server
NODE_ENV=production
PORT=3000

# Frontend (for CORS - must match your Vercel domain)
FRONTEND_URL=https://hireflow.dev

# Database (Railway provides this automatically)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/hireflow_db

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-32-character-hex-string-here-change-this

# === EMAIL CONFIGURATION ===
# Hostinger SMTP Settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@gfactai.com
SMTP_PASS=your-hostinger-email-password
EMAIL_FROM=hello@gfactai.com
