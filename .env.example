# Server
NODE_ENV=production
PORT=3000

# Frontend (for CORS)
FRONTEND_URL=https://hireflow.dev

# Database
DATABASE_URL=postgresql://user:password@host:5432/hireflow_db

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long-change-this

# Optional: Database credentials (if not using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hireflow_db
